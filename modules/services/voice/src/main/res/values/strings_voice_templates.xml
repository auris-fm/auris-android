<resources>
    <string-array name="voice_spoken_templates">
        <item>effects.set_speed|{speed}x speed</item>
        <item>effects.adjust_speed|{speed}x</item>
        <item>effects.set_trim_mode|Silence trim {mode}</item>
        <item>effects.set_volume_boost|Volume boost {on/off}</item>
        <item>effects.query|Speed {speed}x, trim {mode}, volume boost {on/off}</item>
        <item>volume.query|Volume {volume} percent</item>
        <item>sleep.set|Sleep timer set for {minutes} minutes</item>
        <item>sleep.end_of_episode|Sleep timer set for end of episode</item>
        <item>sleep.end_of_chapter|Sleep timer set for end of chapter</item>
        <item>sleep.add_time|{total} minutes remaining</item>
        <item>sleep.cancel|Sleep timer cancelled</item>
        <item>sleep.query|Sleep timer {remaining}</item>
        <item>bookmark.add|Bookmarked at {position}</item>
        <item>playback.next_episode|Playing {episode title}</item>
        <!-- Cloud diagnostics. A code with a user-facing meaning gets its own line
             here; anything else gets the dedicated cloud_error_generic string below, and the error earcon
             only if even that is missing. -->
        <item>general.cloud_coming_soon|Cloud processing is coming soon</item>
        <item>general.cloud_incomplete_turn|Sorry, I couldn\'t complete that request.</item>
        <item>pipeline.unclear_command|I didn\'t catch that.</item>
    </string-array>
    <!-- Daily-limit feedback (task: localized refusal). Per cloud-assistant.md the template must
         name Auris and its daily allowance exactly once and must not be the generic line. It is a
         dedicated string so each values-* locale can override this ONE key without redefining the
         whole template array; SpokenTemplateResolver overlays it onto the resolved map. A missing
         locale entry is a client gap, not a silent fallback to the generic line. -->
    <string name="voice_cloud_error_limit_exceeded" translatable="true">You have reached your Auris free daily limit. Please try again tomorrow.</string>
    <!-- A resume of a conversation the worker no longer holds. Dedicated string for the same reason as
         the daily limit: each values-* locale overrides this one key without redefining the array. -->
    <string name="voice_cloud_error_conversation_expired" translatable="true">That conversation has ended.</string>
    <!-- Synthesis failed, or the service failed internally: one shared line for both codes, so the
         user hears the same apology whichever it was. Dedicated strings, NOT array entries — an array
         entry cannot be overridden per locale without redefining the whole array, which is how these
         two came to be English-only for every non-English speaker. -->
    <string name="voice_cloud_error_answer_unavailable" translatable="true">Sorry, I couldn\'t answer that just now. Please try again.</string>
    <!-- The catch-all for a code with no line of its own. Same reason as above. -->
    <string name="voice_cloud_error_generic" translatable="true">Sorry, I couldn\'t complete that request.</string>
    <!-- Every cloud error line lives OUTSIDE the array, for one reason: an array entry cannot be
         overridden per locale without redefining the whole array, and no values-* does that. Left in
         the array these codes resolved to ENGLISH for every non-English speaker while the daily-limit
         and generic lines beside them were translated. SpokenTemplateResolver overlays each key onto
         the resolved map, so a locale overrides ONE string and the rest still resolve.
         Wording is shared with iOS (spec ruling: the approved set is both apps' copy). -->
    <string name="voice_cloud_error_no_answer" translatable="true">Sorry, I couldn\'t find an answer to that. Please try asking another way.</string>
    <string name="voice_cloud_error_retrieval_unavailable" translatable="true">Sorry, I couldn\'t look that up just now. Please try again.</string>
    <!-- A shared deadline and call budget, not question length: the line must not send the user
         after the wrong cause, and it invents no reset time. -->
    <string name="voice_cloud_error_budget_exceeded" translatable="true">Sorry, that took too long to answer. Please try again.</string>
    <string name="voice_cloud_error_connection_lost" translatable="true">Connection lost. Please try again.</string>
    <!-- The application-level audio queue exceeded its bound. The listener's experience is a
         partial or missing answer; the queue itself is never named. -->
    <string name="voice_cloud_error_queue_overflow" translatable="true">Sorry, I couldn\'t finish answering that. Please try again.</string>
    <!-- Nothing failed: another turn is still answering. No apology, and it says when to retry. -->
    <string name="voice_cloud_error_turn_conflict" translatable="true">I\'m still answering your last question. Please try again in a moment.</string>
    <!-- Prior admissions cannot be established, so a fresh conversation is required. A voice user
         has no separate "start a new conversation" action: asking again IS what starts one. -->
    <string name="voice_cloud_error_corrupt_record" translatable="true">Sorry, I\'ve lost track of our conversation. Please ask again to start a new one.</string>
    <!-- Not in the approved seven: wording unchanged, moved out of the array so it can be
         localized like the rest. -->
    <string name="voice_cloud_error_unauthorized" translatable="true">Service is unavailable at the moment.</string>
    <string name="voice_cloud_error_provider_error" translatable="true">The assistant couldn\'t finish that request.</string>
</resources>
